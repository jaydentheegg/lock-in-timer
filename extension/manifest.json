{
  "manifest_version": 3,
  "name": "Lock-In Noise Filter",
  "version": "1.0.0",
  "description": "Blocks social media, video and game sites, and closes those apps on macOS, while a Lock-In Timer session runs.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["declarativeNetRequest", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://jaydentheegg.github.io/lock-in-timer/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }],
  "action": { "default_title": "Lock-In Noise Filter", "default_popup": "popup.html" },
  "incognito": "spanning"
}
